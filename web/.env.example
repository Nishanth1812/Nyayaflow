# Frontend API configuration
# Copy to web/.env.local and adjust for your environment.

# Local dev (Next.js :3000 + FastAPI :8000):
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Vercel combined deployment (frontend + backend same origin):
# NEXT_PUBLIC_API_BASE=""
# vercel.json routes /health, /cases, /diagnose etc. → api/index.py,
# so the frontend uses relative fetch. Set this to "" in Vercel dashboard.
