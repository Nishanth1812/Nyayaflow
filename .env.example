# NyayaFlow engine configuration
# Copy to .env and adjust for your environment.

# Database. Use SQLite for local dev, or point to Postgres in production:
# NYAYAFLOW_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nyayaflow
# On Vercel, if no Postgres URL is set, the app automatically uses
# sqlite:////tmp/nyayaflow.db (ephemeral) and re-seeds on cold start.
NYAYAFLOW_DATABASE_URL=sqlite:///./nyayaflow.db

# Comma-separated list of allowed frontend origins (CORS).
# Local dev defaults to localhost. On Vercel, VERCEL_URL is auto-added and
# https://*.vercel.app is allowed via regex.
NYAYAFLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for preview deployments: uncomment to customise
# NYAYAFLOW_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional explicit frontend URL (custom domain):
# FRONTEND_URL=https://nyayaflow.vercel.app

# Max requests per client IP per minute.
NYAYAFLOW_RATE_LIMIT_PER_MINUTE=120

# Logging level: DEBUG, INFO, WARNING, ERROR.
NYAYAFLOW_LOG_LEVEL=INFO

# --- Vercel ---
# VERCEL and VERCEL_URL are injected by Vercel; do not set manually.
# For combined frontend+backend deployment, set in Vercel dashboard:
# NEXT_PUBLIC_API_BASE=""   (empty → same-origin, vercel.json routes to api/index.py)
# If using external Postgres (Neon/Supabase), set NYAYAFLOW_DATABASE_URL in Vercel env.
