{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/openapi.json", "dest": "api/index.py" },
    { "src": "/docs", "dest": "api/index.py" },
    { "src": "/docs/(.*)", "dest": "api/index.py" },
    { "src": "/redoc", "dest": "api/index.py" },
    { "src": "/diagnose", "dest": "api/index.py" },
    { "src": "/diagnose/(.*)", "dest": "api/index.py" },
    { "src": "/route", "dest": "api/index.py" },
    { "src": "/diagnostic-rules", "dest": "api/index.py" },
    { "src": "/diagnostic-rules/(.*)", "dest": "api/index.py" },
    { "src": "/cases", "dest": "api/index.py" },
    { "src": "/cases/(.*)", "dest": "api/index.py" },
    { "src": "/metrics", "dest": "api/index.py" },
    { "src": "/evidence-check", "dest": "api/index.py" },
    { "src": "/static/(.*)", "dest": "api/index.py" },
    { "src": "/api/(.*)", "dest": "api/index.py" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
